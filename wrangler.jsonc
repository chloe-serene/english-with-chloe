{
  // Cloudflare Workers static-assets deploy for the English with Chloe site.
  // `npx wrangler deploy` serves the ./site folder as a static website.
  // Only ./site is uploaded — the private research/ folder is never served.
  "name": "daily-chat-with-chloe",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./site"
  }
}
